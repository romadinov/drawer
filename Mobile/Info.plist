	<string>Drawer listens for spoken diagram commands while the microphone button is on.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image with Drawer Diagram</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
